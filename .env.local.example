# Firebase Admin SDK Credentials for Local Development
# Copy this file to .env.local and fill in with your service account JSON
#
# To get the service account JSON:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key"
# 3. Copy the entire JSON content and minify it to a single line
# 4. Paste it as the value below (keep it as a single line JSON string)

FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id",...}'

# Admin Password for Ranking Overrides
# Set a secure password for accessing the admin panel at /admin
# This password is used to create, update, and delete ranking overrides

ADMIN_PASSWORD=your-secure-password-here
