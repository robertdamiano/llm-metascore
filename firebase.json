{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.git",
      "**/.gitignore",
      "**/node_modules/**",
      "functions/**",
      ".env.local"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
